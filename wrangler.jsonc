{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murder-train",
  "main": "src-worker/worker.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // worker runs first so the murdertrain host redirect happens on every path
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "murder.nixfred.com", "custom_domain": true },
    { "pattern": "murdertrain.nixfred.com", "custom_domain": true }
  ]
}
